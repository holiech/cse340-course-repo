
<%- include('partials/header') %>
<main>
    <h1><%= title %></h1>
    <h2>Explore Service Opportunities by Category and find great opportunities to make a difference.</h2>
    <section class="category">
    
        <ul> 
            
            <%categories.forEach(category =>{%>
                <li>
                    
                    <a href="/category/<%= category.category_id %>">
                        <%= category.name %>
                </a>
                </li>

                
            
            <% }) %>
        </ul>
    </section> 

</main>

<%- include('partials/footer') %>



























