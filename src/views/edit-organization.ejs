<%- include('partials/header') %>
<main>
    <h1><%= title %></h1>

  <!-- 1. Changed action to /edit-organization/ with the specific ID -->
  <form action="/edit-organization/<%= organizationDetails.organization_id %>" method="POST">
    
    <div class="form-group">
      <label for="name">Organization Name</label>
      <!-- 2. Pre-populated value attribute -->
      <input
        type="text"
        id="name"
        name="name" 
        value="<%= organizationDetails.name %>" 
        required 
        maxlength="150"
      />
    </div>

    <div class="form-group">
      <label for="description">Description</label>
      <!-- 3. Placed existing data between opening and closing textarea tags -->
      <textarea
        id="description"
        name="description" 
        required 
        maxlength="500"
      ><%= organizationDetails.description %></textarea>
    </div>

    <div class="form-group">
      <label for="contactEmail">Contact Email</label>
      <!-- 4. Pre-populated value attribute -->
      <input
        type="email"
        id="contactEmail"
        name="contactEmail" 
        value="<%= organizationDetails.contact_email %>" 
        required 
        placeholder="example@gmail.com"
      />
    </div>

    <!-- 5. Added the new input field for the logo filename -->
    <div class="form-group">
      <label for="logoFilename">Logo Filename</label>
      <input
        type="text"
        id="logoFilename"
        name="logoFilename" 
        value="<%= organizationDetails.logo_filename %>" 
        required
      />
    </div>

    <!-- 6. Changed the button text to Update -->
    <button type="submit">Update Organization</button>
  </form>

</main>
<%- include('partials/footer') %>



