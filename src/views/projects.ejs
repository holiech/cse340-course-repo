<%- include('partials/header') %>
<main project-page>
    <h1><%= title %></h1>

    <h2>Discover upcoming service projects and join opportunities to serve your community</h2>
    <ul class="project-list">
        <% projects.forEach(project => { %>
            <li class="project-card">

                <div class="project-date"> <%= project.date.toLocaleDateString('en-US', {
                        month: 'long',
                        day: 'numeric',
                        year: 'numeric' 
                    }) %>:
                </div>

                <div project-info>

                    <a href="/project/<%= project.project_id %>">
                        <%= project.title %>
                    </a>


                    (
                    <a href="/organization/<%= project.organization_id %>">
                        <%= project.organization_name %>
                    </a>

                    )
                </div>    

            </li>
        <%});%>
    </ul>
    <p><a href="/new-project">Add a New Service Project</a></p>
        


        
